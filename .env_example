# ports on which should the trello app run these are default values and don't need to be explicitly set
APP="3000"
SERVER="3001"

# Password reset email delivery (use a verified sender)
APP_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Cypress email assertions
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=
